{
	"name": "webmasterskaya/base-soap-lib-dev",
	"description": "Набор инструментов для генерации кода и разработки PHP-SOAP приложения",
	"type": "library",
	"license": "MIT",
	"require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "phpro/soap-client": "~v3",
        "laminas/laminas-code": "^4.14.0",
        "webmasterskaya/base-soap-lib": "^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "friendsofphp/php-cs-fixer": "^3.65",
        "symfony/cache": "^7.0",
        "symfony/http-client": "^7.3"
    },
    "scripts": {
        "cs": [
            "php-cs-fixer fix --ansi --dry-run --diff"
        ],
        "cs-fix": [
            "php-cs-fixer fix --ansi"
        ]
    },
	"autoload": {
		"psr-4": {
			"Webmasterskaya\\Soap\\Base\\Dev\\": "src/"
		}
	},
    "authors": [
        {
            "name": "Artem Vasilev",
            "email": "dev@webmasterskaya.xyz"
        }
    ],
    "minimum-stability": "stable",
	"config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true,
		"allow-plugins": {
			"php-http/discovery": true
		}
	}
}
